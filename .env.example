# Copy to .env and adjust. `node server.js` also runs with these exact defaults.

PORT=3001

# Secret used to sign admin JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Admin dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bierpreis2025

# SQLite file location. Leave unset and the app already defaults correctly
# per environment (./backend/db/bierpreis.db in dev, /app/data/bierpreis.db
# in production — Railway's persistent volume mount) — only set this to
# override that. Shown uncommented here as the local-dev value so copying
# this file straight to .env still works; the production value below is
# what Railway's own environment variables should use instead.
DATABASE_PATH=./backend/db/bierpreis.db
# DATABASE_PATH=/app/data/bierpreis.db

# Telegram admin notifications (optional — leave unset to disable).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
